# Generated by ozone. This file is portable: it carries no machine
# or deployment specific values. HOST_NAME and DISTRO_PATH are NOT stored
# here: they are provided by the invocation (the printed command prefixes
# them; the runner exports them at deployment). Derived values referencing
# ${HOST_NAME} and ${DISTRO_PATH} follow automatically.
SERVER_SCHEME=https
ENABLE_SSO=true
DB_INIT_LIST=alpha beta keycloak
ALPHA_USER=alphauser
ALPHA_PASSWORD=distro-pass
ALPHA_DB=alphadb
ALPHA_CLIENT_SECRET=code-level-secret
KEYCLOAK_USER=kcadmin
ALPHA_DATA_PATH=${DISTRO_PATH}/data
SQL_SCRIPTS_PATH=${DISTRO_PATH}/data
ALPHA_HOSTNAME=${HOST_NAME}:8080
C2C_HOSTNAME=${HOST_NAME}:9090
TIMEZONE=UTC
C2C_EXTRA=c2c
